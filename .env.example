# Environment variables for Docker Compose. Copy to .env and edit.
POSTGRES_USER=corpus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=corpus
WEB_PORT=8080
# Address the site binds to; 0.0.0.0 exposes it without a reverse proxy
# WEB_HOST=127.0.0.1
# OAuth client ID for Google sign-in, see README
GOOGLE_CLIENT_ID=
