generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// A Google account that has signed in
model User {
  id        Int             @id @default(autoincrement())
  // Google's stable account id ("sub"); the email can change
  googleId  String          @unique
  email     String
  name      String          @default("")
  picture   String          @default("")
  createdAt DateTime        @default(now())
  sessions  Session[]
  projects  ProjectMember[]
}

model Session {
  // SHA-256 of the token in the cookie, so a database leak exposes no tokens
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Top-level workspace; documents, annotations and tags never cross projects
model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String          @default("")
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
  documents   Document[]
  annotations Annotation[]
  tags        Tag[]
  tagGroups   TagGroup[]
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

// Who can access a project and how; sharing a project adds rows here
model ProjectMember {
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Document {
  id          Int          @id @default(autoincrement())
  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  filename    String? // null when the content was not imported from a file
  content     String
  createdAt   DateTime     @default(now())
  annotations Annotation[]

  @@index([projectId])
}

model Annotation {
  id           Int              @id @default(autoincrement())
  // Kept on the annotation itself because the document is optional
  projectId    Int
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId   Int?
  document     Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // Snapshot of the context, kept even if the document is gone
  context      String
  // Position of the context in the document content
  contextStart Int?
  contextEnd   Int?
  spans        AnnotationSpan[]
  // Free-form origin of the annotation, e.g. the file number from an import
  source       String           @default("")
  description  String           @default("")
  tags         Tag[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId])
  @@index([documentId])
}

// One annotated piece of text; an annotation may have several, all inside its
// context and never overlapping
model AnnotationSpan {
  id           Int        @id @default(autoincrement())
  annotationId Int
  annotation   Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  // Snapshot of the span text, kept even if the document is gone
  text         String
  // Offsets within the annotation's context
  start        Int
  end          Int
  // Offsets in the document content, used for highlighting
  docStart     Int?
  docEnd       Int?

  @@index([annotationId])
}

// Organizes tags for display, e.g. 主詞 and 受詞 under 詞性
model TagGroup {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  tags        Tag[]

  @@unique([projectId, name])
}

model Tag {
  id          Int          @id @default(autoincrement())
  projectId   Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // null when the tag is not in any group
  groupId     Int?
  group       TagGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  description String       @default("")
  annotations Annotation[]

  @@unique([projectId, name])
  @@index([groupId])
}
